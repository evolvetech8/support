# ==============================================================================
# Archonic Studio — Environment Variables
# ==============================================================================

# 1. Dashboard Authentication (Required to lock the /dashboard route)
DASHBOARD_PASSWORD=your_secure_password_here
SESSION_SECRET=optional_random_64_char_hex_for_hmac

# 2. Vercel Cron Authentication (Protects /api/sync from public access)
# Vercel automatically injects Authorization: Bearer <CRON_SECRET> for cron jobs
CRON_SECRET=generate_a_random_32_char_token

# 3. Neon Postgres Database (Added automatically when connecting Neon in Vercel)
# Format: postgresql://[user]:[password]@[neon-hostname]/neondb?sslmode=require
DATABASE_URL=

# 4. Apple App Store Connect API (Team Key with Admin role)
# App Store Connect -> Users and Access -> Integrations -> App Store Connect API
ASC_ISSUER_ID=57246542-96fe-1a63-e053-0824d011072a
ASC_KEY_ID=2X9R4HXF34
ASC_VENDOR_NUMBER=80012345

# The .p8 private key downloaded from Apple. Can be multi-line PEM, single-line with \n, or base64.
ASC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQg...\n-----END PRIVATE KEY-----"
